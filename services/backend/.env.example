MYHOME_APP_NAME=MyHome-Backend
MYHOME_ENVIRONMENT=dev
MYHOME_DEBUG=true
MYHOME_DATABASE_URL=postgresql+asyncpg://myhome:myhome_dev@localhost:5432/myhome
MYHOME_CORS_ORIGINS=*
MYHOME_JWT_SECRET=dev-secret-change-in-production-please
MYHOME_JWT_ALGORITHM=HS256
MYHOME_ACCESS_TOKEN_EXPIRE_MINUTES=1440
MYHOME_REFRESH_TOKEN_EXPIRE_DAYS=90
MYHOME_POOL_SIZE=5

# 讯飞语音评测（朗读练习用）—— 仅在用 child 朗读评分功能时配置
# 从 https://www.xfyun.cn 注册「语音评测」服务后获取；留空则朗读练习降级为固定等待模式
MYHOME_IFLYTEK_APP_ID=
MYHOME_IFLYTEK_API_KEY=
MYHOME_IFLYTEK_API_SECRET=
MYHOME_READING_PASS_SCORE=60
