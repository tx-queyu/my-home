# 拷贝为 .env 后修改：
# cp .env.prod.example .env.prod
# 修改 MYHOME_JWT_SECRET 为强随机串、POSTGRES_PASSWORD 为强随机串
# 启动：docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# Postgres
POSTGRES_USER=myhome
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_RANDOM
POSTGRES_DB=myhome

# Backend
MYHOME_APP_NAME=MyHome-Backend
MYHOME_ENVIRONMENT=prod
MYHOME_DEBUG=false
# Android App 不发 Origin 头，CORS 默认 * 即可；后续加 web 端时改具体域名
MYHOME_CORS_ORIGINS=*
MYHOME_JWT_SECRET=CHANGE_ME_TO_48_CHAR_RANDOM_STRING
MYHOME_JWT_ALGORITHM=HS256
MYHOME_ACCESS_TOKEN_EXPIRE_MINUTES=1440
MYHOME_REFRESH_TOKEN_EXPIRE_DAYS=90
MYHOME_POOL_SIZE=5
# 部署后用 curl 创建首个家庭，然后改回 false 重启 backend
MYHOME_REGISTRATION_ENABLED=false
